[Unit]
Description=AC Energy Dashboard - PostgreSQL
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=YOUR_PI_USER
WorkingDirectory=/home/YOUR_PI_USER/ac_energy_pi_package
Environment="DATABASE_URL=postgresql://ac_energy:CHANGE_ME@127.0.0.1:5432/ac_energy"
Environment="AC_DB_FLUSH_SECONDS=10"
Environment="AC_DB_BATCH_SIZE=1000"
ExecStart=/home/YOUR_PI_USER/ac_energy_pi_package/venv/bin/python /home/YOUR_PI_USER/ac_energy_pi_package/app_postgres.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
